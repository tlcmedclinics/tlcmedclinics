# --- Firebase client (from Firebase Console > Project Settings > General) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Project Settings > Service Accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n kept literal (this app converts them back to real newlines)
FIREBASE_PRIVATE_KEY=

# --- Cloudinary (cloudinary.com dashboard) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email notifications (Nodemailer via SMTP — Gmail app password, or any SMTP provider) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CLINIC_NOTIFY_EMAIL=

# --- Payments (fully wired — see /patient/book) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard -> Developers -> Webhooks -> Add endpoint
# {your domain}/api/payments/stripe/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# "sandbox" (default, safe to leave unset while testing) or "live"
PAYPAL_ENV=sandbox
# Neither Stripe nor PayPal settle in PKR for Pakistan-registered accounts, so
# checkout charges in this currency instead (booking amounts entered in PKR
# are passed through as-is — set a real conversion once you know your payout
# currency, or collect amounts directly in this currency).
PAYMENT_CURRENCY=usd
NEXT_PUBLIC_PAYMENT_CURRENCY=usd
# Stripe does not support Pakistan-registered accounts directly — most clinics
# either use a foreign entity/Stripe Atlas, or lead with PayPal + local rails
# (JazzCash/EasyPaisa) and add Stripe once that's sorted.

# --- Video calling (daily.co dashboard → Developers) — added in Phase 2 ---
DAILY_API_KEY=

# --- Chat encryption — generate with: openssl rand -base64 32 ---
# Server-only secret used to derive a unique AES-GCM key per chat thread.
# Never exposed to the browser. Rotating this makes old messages
# undecryptable, so back it up somewhere safe (e.g. your secrets manager).
CHAT_ENCRYPTION_KEY=

# --- WhatsApp — click-to-chat needs no key; the Business API needs a Meta app + BSP (e.g. Twilio) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Twilio (phone sign-in) ----
# Phone sign-in sends its code through Twilio Verify, not Firebase Phone Auth.
# Verify generates the code and owns its expiry and attempt limits.
#
# 1. Twilio Console -> Account info -> Account SID + Auth Token
# 2. Twilio Console -> Verify -> Services -> create one -> copy its Service SID
# 3. SMS to Pakistani numbers needs a sender approved for +92 traffic; check
#    Twilio's Pakistan guidelines before going live.
#
# With these unset the phone tab reports that phone sign-in isn't configured,
# and email sign-in keeps working normally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- SEO ----
# The site's public origin, with no trailing slash. Every canonical URL, the
# sitemap, robots.txt and every OpenGraph image is built from this, so it must
# be the exact address people reach the site at — https, and the same
# www/non-www form the domain actually serves.
#
# Leave it unset on preview deployments: a preview then falls back to its own
# URL instead of claiming to be production, which is what stops Google indexing
# a preview in place of the real site.
NEXT_PUBLIC_SITE_URL=https://tlcmedclinics.com

# Google Search Console -> Settings -> Ownership verification -> HTML tag.
# Copy only the value of the `content="..."` attribute, not the whole tag.
# Not needed if the domain is already verified by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
